# Token del tunnel Cloudflare (Zero Trust > Networks > Tunnels > il tuo tunnel > token)
CLOUDFLARE_TUNNEL_TOKEN=

# Chiave usata per firmare i JWT e per cifrare api_hash e sessioni Telegram nel database.
# Generala con: openssl rand -hex 32
# Se la cambi, le sessioni Telegram salvate non sono piu decifrabili e vanno rifatte.
APP_SECRET=

# Fuso orario dei container
TZ=Europe/Rome

# Porta locale del frontend (oltre al tunnel)
FRONTEND_PORT=8081
