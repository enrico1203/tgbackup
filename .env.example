# Cloudflare tunnel token (Zero Trust > Networks > Tunnels > your tunnel > token)
CLOUDFLARE_TUNNEL_TOKEN=

# Key used to sign the JWTs and to encrypt api_hash, Telegram sessions and the rclone
# configuration in the database.
# Generate it with: openssl rand -hex 32
# If you change it, the stored secrets can no longer be decrypted and must be entered again.
APP_SECRET=

# Container time zone
TZ=Europe/Rome

# Local port for the frontend, in addition to the tunnel
FRONTEND_PORT=8081

# Seconds a 512KB part may go unanswered before its connection is rebuilt and the part is
# sent again. Telegram stops answering a set of connections without saying so, and this is
# how long that costs. A part normally comes back in about a second; the value has to stay
# far above that, because a deadline shorter than the line can answer in only sends the
# same part twice. Leave it alone unless the uplink is slow, where it should go up.
TELEGRAM_PART_TIMEOUT=45

# Tag of the published images, only read by docker-compose.hub.yml. latest follows the
# releases; a version pins the installation to it, written without the v of the git tag,
# so 0.1.0 or 0.1 and not v0.1.0.
TGBACKUP_TAG=latest

# The version stamped on images built from the sources is not set here: it comes from
# git, on the build command, so that it can never say something the working copy has
# stopped being. See "Updating" in the README.
