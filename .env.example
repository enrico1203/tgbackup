# Cloudflare tunnel token (Zero Trust > Networks > Tunnels > your tunnel > token)
CLOUDFLARE_TUNNEL_TOKEN=

# Key used to sign the JWTs and to encrypt api_hash, Telegram sessions and the rclone
# configuration in the database.
# Generate it with: openssl rand -hex 32
# If you change it, the stored secrets can no longer be decrypted and must be entered again.
APP_SECRET=

# Container time zone
TZ=Europe/Rome

# Local port for the frontend, in addition to the tunnel
FRONTEND_PORT=8081

# Tag of the published images, only read by docker-compose.hub.yml. latest follows the
# releases; a version pins the installation to it, written without the v of the git tag,
# so 0.1.0 or 0.1 and not v0.1.0.
TGBACKUP_TAG=latest

# Version stamped on the images built from the sources, which the update banner compares
# with what is published on Docker Hub. Leave it out and a build from the sources is
# "dev", which never claims to be out of date: a working copy is not a release.
# APP_VERSION=0.6.0
